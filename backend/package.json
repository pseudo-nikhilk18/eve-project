{
  "name": "eve-backend",
  "version": "1.0.0",
  "description": "API for the EVE Healthcare diagnostic booking application",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env db/seed.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "test:integration": "node --test --test-concurrency=1 integration/postgresql.integration.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
